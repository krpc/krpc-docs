   }
 
+  /** Invoke a remote procedure call by id. The names are for the local return type lookup. */
+  public KRPC.ProcedureResult invoke(
+      String service, String procedure, int serviceId, int procedureId, ByteString... arguments)
+      throws RPCException {
+    KRPC.Type.TypeCode code;
+    try {
+      code = getReturnTypeCode(service, procedure);
+    } catch (IOException exn) {
+      throw new RPCException("Failed to invoke call", exn);
+    }
+    boolean addsStream = code == KRPC.Type.TypeCode.STREAM || code == KRPC.Type.TypeCode.EVENT;
+    KRPC.ProcedureCall call =
+        buildCall("", "", arguments).toBuilder()
+            .setServiceId(serviceId)
+            .setProcedureId(procedureId)
+            .build();
+    return getCheckedResult(invokeInternal(call, addsStream));
+  }
+
   private KRPC.ProcedureResult invoke(KRPC.ProcedureCall call) throws RPCException {
     return getCheckedResult(invokeInternal(call));
   }
